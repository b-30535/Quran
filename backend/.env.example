# Copy this file to .env for local development. Never commit real secrets.
APP_NAME=Noor Al-Quran API
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Create a MongoDB Atlas database and paste its connection string here.
MONGODB_URI=
MONGODB_DATABASE=noor_al_quran

# Generate a secret locally, e.g. Python: secrets.token_urlsafe(48)
# Keep it private and never put it in frontend code or commit it.
JWT_SECRET_KEY=
JWT_ISSUER=noor-al-quran-api
ACCESS_TOKEN_MINUTES=30

# Comma-separated exact frontend origins. Do not use * with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500
